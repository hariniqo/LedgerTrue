# Copy to .env (never commit .env). All values below are placeholders.
PORT=3000
NODE_ENV=development

# Explicit local demo mode. Open demo access binds only to 127.0.0.1.
# Set false in shared deployments and provide both auth tokens.
DEMO_MODE=true
# Required when DEMO_MODE=false. Long random strings (e.g. `openssl rand -hex 32`).
OPERATOR_TOKEN=
AGENT_TOKEN=
# Optional: long random string used to sign short-lived tokens (see tools/mint-token.mjs). Leave empty to disable.
TOKEN_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal dashboard. If empty, incoming webhooks are NOT signature-verified (demo only).
PAYPAL_WEBHOOK_ID=


# PayPal sandbox may not accept INR cross-border. Leave empty: USD with PayPal, INR in the simulator.
DEMO_CURRENCY=

# --- AI (optional; every model call is advisory and can never move money) ---
# One setting works for any OpenAI-compatible provider. Examples (confirm current model names in the provider's docs):
#   NVIDIA : AI_BASE_URL=https://integrate.api.nvidia.com/v1       (key starts nvapi-, from build.nvidia.com)
#   Groq   : AI_BASE_URL=https://api.groq.com/openai/v1
#   Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-ai-api-key
# AI_BASE_URL=your-ai-base-url
# AI_MODEL=your-ai-model
# The older NVIDIA_* names below still work and are used when the AI_* ones are empty.
# NVIDIA NIM explainer (optional - get an API key from build.nvidia.com; it starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

VERIFY_AFTER_MS=8000
CAPTURE_TIMEOUT_MS=8000

# Append-only logs
PERSIST_FILE=data/events.jsonl
CHAIN_DIR=data/chains
GUARD_KEY_FILE=data/guard-key.json

# Anchoring: every chain block produces a guard-signed anchor. Push them somewhere the operator cannot edit.
ANCHOR_FILE=data/anchors.jsonl
# Optional: each anchor is POSTed here as JSON (a GitHub Action, a notary, a Slack channel). Without it the log is signed but not independent.
ANCHOR_WEBHOOK_URL=
# Pending PayPal approvals and unconfirmed captures survive restarts here.
PENDING_FILE=data/pending.json

# Responsible AI: set to true to remove every model call. LedgerTrue then runs on deterministic rules and text only.
AI_DISABLED=false

# --- AI/ML intelligence layer (optional; see docs/AI_ML.md) ---
# Leave ML_SERVICE_URL empty to use the built-in rule baseline.
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
ML_SERVICE_TIMEOUT_MS=1500
# When true, a high spend-risk score asks the owner to review (never blocks, never approves).
ML_RISK_ESCALATION=false
ML_RISK_THRESHOLD=0.5

# Optional owner alerts (ntfy-compatible). Use a long, private topic name. PUBLIC_URL makes the alert open the mandate.
NOTIFY_URL=
PUBLIC_URL=